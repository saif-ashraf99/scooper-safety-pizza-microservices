# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# Database Configuration
DATABASE_PATH=./data/violations.db

# Streaming Service Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# Detection Service Configuration
MODEL_PATH=./models/yolo12m-v2.pt
CONFIDENCE_THRESHOLD=0.7
SCOOPER_DISTANCE_THRESHOLD=100.0

# Frame Reader Configuration
VIDEO_SOURCE=0
FPS_LIMIT=30.0

# Streamlit Configuration
DEFAULT_API_BASE_URL = "http://streaming_service:8000"
DEFAULT_WS_URL = "ws://streaming_service:8000/ws/video"

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=./logs/app.log

